# ==============================================================================
# Python & Bytecode
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll

# ==============================================================================
# Virtual Environments & Packaging
# ==============================================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==============================================================================
# Testing & Code Coverage
# ==============================================================================
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/

# ==============================================================================
# Node & Frontend (React / Vite)
# ==============================================================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# Environment & Sensitive Credentials
# ==============================================================================
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
# Allow example environment file
!.env.example

# ==============================================================================
# Databases & Local History (Privacy-Preserving)
# ==============================================================================
*.db
*.sqlite
*.sqlite3
codeinsight.db
codeinsight.db-journal
codeinsight.db-shm
codeinsight.db-wal

# ==============================================================================
# Machine Learning Weights & Large Model Files (> 100MB)
# (Architecture configs, label maps, and tokenizers remain trackable)
# ==============================================================================
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.tflite

# Exclude large binary model checkpoints while keeping metadata
models/codebert_classifier/*.safetensors
models/codebert_classifier/*.bin
models/codebert_classifier/*.pt

# ==============================================================================
# Generated Figures & Artifacts
# ==============================================================================
artifacts/figures/*.png
artifacts/figures/*.jpg
artifacts/figures/*.svg
artifacts/figures/*.pdf
# Preserve benchmark metrics JSON and keep directories
!artifacts/metrics/
!artifacts/metrics/*.json
!artifacts/figures/.gitkeep

# ==============================================================================
# IDEs & Editor Metadata
# ==============================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ==============================================================================
# OS Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ==============================================================================
# Logs & Temporary Files
# ==============================================================================
*.log
logs/
scratch/

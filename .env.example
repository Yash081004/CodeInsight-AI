# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model Configuration
CODEBERT_MODEL_NAME=microsoft/codebert-base
MAX_CODE_LENGTH=512
SIMILARITY_THRESHOLD=0.8
DEVICE=auto

# Paths
DATA_DIR=./data
MODELS_DIR=./models
ARTIFACTS_DIR=./artifacts

# Database
DATABASE_URL=sqlite:///./codeinsight.db

# Training Defaults
TRAIN_BATCH_SIZE=16
EVAL_BATCH_SIZE=32
LEARNING_RATE=2e-5
NUM_EPOCHS=5
SEED=42
